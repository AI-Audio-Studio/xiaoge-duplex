# ─────────────────────────────────────────────────────────────────────────────
# Xiaoge Duplex Speech（小歌 全双工语音交互引擎）配置样例 / config catalog
#
# 复制为 .env 后按需修改：  cp .env.example .env
# 运行时由 python-dotenv 和 start.ps1 自动加载。这是本工程“统一的配置文件”，
# 不需要单独的 config 目录（详见 RUN.md 的「配置管理」一节）。
# 带默认值的项可留空/删除——代码里已有内置默认。
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM：Qwen（OpenAI 兼容网关）────────────────────────────────────────────────
QWEN_BASE_URL=https://60.205.197.165:10092/llm/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL=Qwen3-4B
QWEN_VERIFY_SSL=false

# ── STT / ASR ────────────────────────────────────────────────────────────────
# 一键切换整条 ④:upstream(原始,默认)| optimized(流式主STT+GAP判停聚合+真关麦)。
# optimized 默认主STT=funasr-stream;STT_BACKEND 可显式覆盖。LIVE 充分验证后再翻默认。
XIAOGE_STACK=upstream
# 主STT 后端:funasr(离线,默认) | funasr-stream(FunASR 2pass 流式,GAP聚合+VAD门控)
#           | qwen3 | qwen3-stream | iflytek(讯飞 RTASR,可选第三方)。流式后端不过 StreamAdapter。
STT_BACKEND=funasr
# GAP 轮次聚合静默阈值(秒,以最后有声帧起算):静默≥GAP 才算一轮结束。
# 1.0 对带思考停顿/重复的口语过切(半句被切→答非所问),起点改 1.5;太碎调大、嫌慢调小。
XIAOGE_AGG_GAP=1.5
# 在线软打断的 VAD 佐证宽限(秒):文本到达时 VAD 须确认用户在说话(或刚停 <此值)才打断,
# 防短幽灵词/接话误打断小歌。调大更宽松(易误打断)、调小更严。
XIAOGE_ONLINE_VAD_GRACE=0.6
# 讯飞 RTASR(STT_BACKEND=iflytek 时用;到 https://console.xfyun.cn 申请,实时语音转写 RTASR):
IFLYTEK_APPID=your-iflytek-appid
IFLYTEK_API_KEY=your-iflytek-apikey
FUNASR_WS_URL=wss://60.205.197.165:10090
FUNASR_VERIFY_SSL=false
# 仅在切到对应后端时使用；需指向本机可达的地址，否则切过去无识别（但不会卡死）。
QWEN3_ASR_WS_URL=ws://60.205.197.165:10091/ws/transcribe
QWEN3_ASR_STREAM_WS_URL=ws://10.212.164.230:10091/ws/transcribe
# ASR WebSocket 连接超时（秒）。连不上的后端在此时间内快速失败。
ASR_WS_CONNECT_TIMEOUT=5

# ── TTS：百炼 / DashScope ──────────────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 默认 TTS 后端：cosyvoice | qwen | http（网页面板可在运行时切换）
TTS_BACKEND=cosyvoice
# Qwen TTS Realtime（qwen 后端）：
BAILIAN_TTS_MODEL=qwen-tts-realtime
BAILIAN_TTS_VOICE=Ethan
# CosyVoice（cosyvoice 后端）：
COSYVOICE_MODEL=cosyvoice-v3-flash
# 默认女声 龙小淳（知性积极女）。其他候选女声（同为 cosyvoice-v3 系列）：
#   longanwen_v3 龙安温 优雅知性女 | longanrou_v3 龙安柔 温柔闺蜜女 | longanli_v3 龙安莉 利落从容女
COSYVOICE_VOICE=longxiaochun_v3
# 预热连接池大小（提前建好 WS 连接消除每轮握手）。密集打断场景调大更稳，默认 3。
COSYVOICE_POOL_SIZE=3
# 可选：情感/风格指令（自然语言，留空=不加）。例：COSYVOICE_INSTRUCTION=语气温柔一点
# COSYVOICE_INSTRUCTION=
# 切到 http TTS 后端时使用：
HTTP_TTS_URL=http://10.212.164.230:8001

# ── 关键词强打断 KWS（sherpa-onnx）────────────────────────────────────────────
# 说话喊“停 / 别说了 / 等等”等可强行打断播报。所有项都有内置默认，整段留空也能用；
# 缺模型/依赖时自动降级为 no-op，不影响启动。下面每行是“变量=默认值”，按需取消注释覆盖。
#
# 开关与模型（默认即可，通常无需改）：
#   XIAOGE_KWS_ENABLE_NATIVE=1      # 1 开启 / 0 关闭
#   XIAOGE_KWS_MODEL_DIR=<repo>/models/kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
#                                   # 留空=自动定位到工程内 models/kws/ 的模型目录
#
# 关键词表（二选一；都不设则用内置词表：停/停下/停一下/别说了/你别说了/别讲了/等等/等一下/不要讲了）：
#   XIAOGE_KWS_KEYWORDS=停|停一下|别说了        # 用 | 分隔，自动转拼音；优先于词表文件
#   XIAOGE_KWS_KEYWORDS_FILE=<path>             # 直接指定 sherpa 关键词文件；留空=模型目录里的 generated-keywords.txt
#
# 召回 / 灵敏度调优：
#   XIAOGE_KWS_KEYWORDS_SCORE=1.0     # 关键词加权得分（越大越易命中）
#   XIAOGE_KWS_KEYWORDS_THRESHOLD=0.18  # 命中阈值，越低越灵敏（越易召回也越易误触）
#   XIAOGE_KWS_NUM_TRAILING_BLANKS=1    # 命中后再等几个 blank 帧才触发，越小打断越快
#   XIAOGE_KWS_DEBOUNCE_MS=800          # 两次命中的最小间隔（毫秒），防抖
#
# 本机实测推荐（已在 .env 启用）：阈值降到 0.12 提召回（0.18 时单字“停”常漏召回），
# trailing blanks 设 0 让打断快一拍：
XIAOGE_KWS_KEYWORDS_THRESHOLD=0.12
XIAOGE_KWS_NUM_TRAILING_BLANKS=0

# ── 判停（turn-taking）旋钮 ────────────────────────────────────────────────────
# 全部默认 = 当前线上值，不设即无变化。用于判停调优/扫参（见 turn_config.py）。
# VAD 静音阈值（秒）：多长停顿算"说完一段"，是主切分源；调大可减少把连续话切成多轮。
TURN_VAD_MIN_SILENCE=0.35
# endpointing 收尾窗口（秒）：调大 max 给"还没说完"留时间，但 felt 延迟会上升。
TURN_ENDPOINT_MIN_DELAY=0.3
TURN_ENDPOINT_MAX_DELAY=0.6
# 抢跑预生成（true/false）：关掉可减少"被续话打断后留下残片回复"。
TURN_PREEMPTIVE_TTS=true
# 打断阈值（次要）：min_words / min_duration 秒 / backchannel 边界"低,高"秒。
TURN_INTR_MIN_WORDS=3
TURN_INTR_MIN_DURATION=2.0
TURN_INTR_BACKCHANNEL=1.8,3.5
# 判停 KPI（仅 -Test/AGENT_TIMELINE 测试模式生效，正式版不统计）：
# 过度切分启发式的相邻轮间隔阈值（秒）、felt 延迟预算（毫秒，用于达标判定）。
TURN_OVERSEG_GAP=1.5
TURN_FELT_BUDGET_MS=1500

# ── LiveKit（console 模式也需要这些占位值）──────────────────────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkeydevkeydevkeydevkeydevkey12
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevse

# ── Web 测试面板 / 调试 ─────────────────────────────────────────────────────────
# 网页面板端口（默认 8787，被占用会自动顺延）
WEB_UI_PORT=8787
# 用户语音实时转写显示（边说边长的 live 气泡）。默认开；设 0 关闭=完全回到原行为。
LIVE_TRANSCRIPT=1
# 连续/新轮分界（秒）：距上次活动超过此值的再次开口视为新的一句→新气泡，之内则并入当前气泡。
LIVE_TRANSCRIPT_NEW_TURN_GAP=1.5
# 日志级别：DEBUG 时 .run/agent.log 记录最详细（含 VAD/STT/KWS）
# LIVEKIT_LOG_LEVEL=DEBUG

# ── 自动化测试:录音回放注入（阶段1）─────────────────────────────────────────────
# 设了才启用（默认不设=正常麦克风，零影响）。指向一个 wav，或一个 json：
#   {"wav": "user.wav", "expect": "用户实际说的话(可选,用于算覆盖率/丢字)",
#    "lead_silence_s": 4.0, "frame_ms": 10}
# 用法：把要复现的录音(如 runs/<ts>/user.wav)路径填进来，配合 -Test 看 turn_kpis.json。
# AGENT_SCENARIO=runs/20260622_181317/user.wav
